APP_NAME="AF GPS TRACKER"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zona waktu PENYIMPANAN (dipakai Carbon & kolom timestamp).
APP_TIMEZONE=Asia/Jakarta

# Zona waktu TAMPILAN bawaan untuk pengguna yang belum memilih sendiri.
# Pengguna bisa menggantinya per akun lewat profil (WIB/WITA/WIT) -
# lihat users.timezone dan App\Helpers\AppTime.
APP_DISPLAY_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=af_gps_tracker
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di production (HTTPS) supaya cookie sesi selalu pakai flag Secure.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP Gmail. MAIL_PASSWORD wajib App Password (bukan password akun biasa).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# WhatsApp (Fonnte) - https://fonnte.com
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# Geocoding (LocationIQ) - fallback ke Nominatim gratis kalau kosong.
# Daftar gratis: https://locationiq.com
LOCATIONIQ_API_KEY=

# =====================================================
# AKUN DEMO (seeder)
# =====================================================

# Dipakai DemoAccountSeeder. Kosongkan supaya seeder membuat kata sandi
# acak dan mencetaknya sekali ke layar - jangan pernah menulis kata sandi
# asli di dalam kode seeder, repositori ini publik.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_DEVICE_ID=
DEMO_DEVICE_PASSWORD=

# =====================================================
# EXPORT PDF
# =====================================================

# Batas jumlah baris per dokumen PDF. Kosongkan/0 supaya dihitung
# otomatis dari memory_limit PHP di server (lihat PdfExportService).
PDF_MAX_ROWS=0

# MQTT Broker (perangkat GPS publish lokasi ke sini via mqtt:subscribe)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=laravel-gps-tracker
# Wajib false - clean session tidak kompatibel dengan auto-reconnect.
MQTT_CLEAN_SESSION=false
MQTT_KEEP_ALIVE=60
MQTT_TIMEOUT=5
MQTT_QOS=1
MQTT_TOPIC=gps/+/location
# Wajib true di production - lihat MQTTSignatureService.
MQTT_REQUIRE_SIGNATURE=true
MQTT_RECONNECT_AUTOMATIC=true
MQTT_RECONNECT_MAX_ATTEMPTS=10
MQTT_RECONNECT_DELAY_MS=3000
MQTT_USE_TLS=false
MQTT_CA_FILE=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=

# Alert (baterai lemah, device offline) - jalankan scheduler
# (`php artisan schedule:work` atau cron) supaya device:health-check
# berjalan tiap menit dan alert offline terkirim.
LOW_BATTERY_THRESHOLD=20
OFFLINE_ALERT_THRESHOLD_MINUTES=5

VITE_APP_NAME="${APP_NAME}"
