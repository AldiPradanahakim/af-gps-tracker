{
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "lib": ["ES2020"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": ["node"],
        "declaration": true,
        "emitDeclarationOnly": true
    },
    "include": ["vite.config.js"]
}
